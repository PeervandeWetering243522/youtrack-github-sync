{
  "name": "youtrack-gh",
  "version": "0.0.0-development",
  "private": true,
  "description": "Read-only YouTrack -> GitHub issue mirror (Cloudflare Workers cron, GitHub Action or Node); releases are the v* git tags",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "gen:youtrack": "openapi-typescript youtrack-openapi.json -o src/generated/youtrack.ts",
    "gen:worker-types": "wrangler types -c wrangler.example.jsonc --env-file .env.example --strict-vars=false",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "sync": "node --env-file-if-exists=.env src/node.ts",
    "dev:worker": "wrangler dev --test-scheduled"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/openapi-types": "^29.0.1",
    "@types/node": "^26.6.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "semantic-release": "25.0.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true
  }
}
