{
  "name": "youtrack-gh",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only YouTrack -> GitHub issue mirror (Cloudflare Workers cron / Node)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "gen:youtrack": "openapi-typescript youtrack-openapi.json -o src/generated/youtrack.ts",
    "gen:worker-types": "wrangler types",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "sync": "node --env-file-if-exists=.env src/node.ts",
    "dev:worker": "wrangler dev --test-scheduled"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@octokit/openapi-types": "^29.0.1",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true
  }
}
