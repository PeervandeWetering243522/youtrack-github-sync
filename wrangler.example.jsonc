// Copy to wrangler.jsonc (gitignored), then fill in GITHUB_REPO and YOUTRACK_PROJECT:
//   cp wrangler.example.jsonc wrangler.jsonc
// wrangler reads wrangler.jsonc. `npm run gen:worker-types` reads this file instead, so the
// committed worker-configuration.d.ts is the same for everyone.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtrack-gh-mirror",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",

  // Scheduled-only Worker: no public URLs at all (docs/04, section 6).
  "workers_dev": false,
  "preview_urls": false,

  "triggers": {
    "crons": ["*/10 * * * *"],
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },

  // Non-secret config. Secrets GITHUB_TOKEN and YOUTRACK_TOKEN are set with
  // `wrangler secret put <NAME>` and never live in this file.
  "vars": {
    // Your mirror repository, "owner/repo", e.g. "BredaUniversityADSAI/my-group-repo".
    "GITHUB_REPO": "",
    // The BUas instance; change it only if your project lives elsewhere.
    "YOUTRACK_BASE_URL": "https://youtrack.ai.buas.nl",
    // Your project's shortName: the part of its issue IDs before the dash, e.g. "ABC" for ABC-12.
    "YOUTRACK_PROJECT": "",
    "YOUTRACK_EXCLUDE_PREFIX": "[individual]",
    "MAX_WRITES_PER_RUN": "30",
    // Only "false" sends writes. Keep "true" until a dry run's log looks right (README, step 7).
    "DRY_RUN": "true",
  },
}
