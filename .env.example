# Copy to .env (gitignored) for local runs. `npm run sync` reads it via
# node --env-file-if-exists, and `npm run dev:worker` (wrangler dev) loads it
# into the Worker's env, where it overrides the vars in wrangler.jsonc.
#
# Keep every line plain KEY=value with comments on their own lines: systemd's
# EnvironmentFile= does not strip inline comments the way Node does.

# --- Secrets: never commit real values. Empty values fail fast at startup. ---

# GitHub classic personal access token with the `repo` scope (decision B12).
GITHUB_TOKEN=
# YouTrack permanent token. Only GET /api/issues is ever called with it.
YOUTRACK_TOKEN=

# --- Non-secret config (the deployed Worker takes these from wrangler.jsonc "vars"). ---
# GITHUB_REPO, YOUTRACK_BASE_URL and YOUTRACK_PROJECT are required: `npm run sync` does not
# read wrangler.jsonc, so keep them in .env. The other three have defaults.

# Target repository, "owner/repo".
GITHUB_REPO=BredaUniversityADSAI/2026-27s1-fai3-adsai-ComfyUI
# https URL of the YouTrack instance, without query string, fragment or credentials.
YOUTRACK_BASE_URL=https://youtrack.ai.buas.nl
# Project shortName: starts with a letter or digit, then letters, digits, "_" or "-".
YOUTRACK_PROJECT=CUI
# Every issue and epic is mirrored except those whose summary starts with this
# (case-insensitive), and everything below such an issue in the YouTrack hierarchy.
# Replaces YOUTRACK_TITLE_PREFIX, which is no longer read.
YOUTRACK_EXCLUDE_PREFIX=[individual]
# GitHub writes per run, 0 to 40. Every write counts as 1: a create, close, update, move,
# detach, milestone create or close, and a label re-add.
MAX_WRITES_PER_RUN=30
# Only "false" (any case, surrounding whitespace ignored) sends writes. Anything else, or
# leaving it out, is a dry run.
# Note: wrangler dev reads this file too, so "false" here makes local Worker runs write as well.
DRY_RUN=true
